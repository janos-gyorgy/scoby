{
  "name": "scoby",
  "version": "1.0.0",
  "description": "A free Kimchi: pi extensions for role routing across free-tier APIs, with budget-first compaction",
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test extensions/router/core.test.ts extensions/compaction/shaper.test.ts extensions/compaction/fold.test.ts extensions/guard/gates.test.ts",
    "test:router": "test/router/run.sh",
    "test:failover": "test/failover/run.sh",
    "test:compaction": "test/compaction/run.sh",
    "test:resume": "test/router/run-glitch.sh",
    "test:guard": "test/guard/run.sh",
    "test:all": "npm test && npm run test:router && npm run test:resume && npm run test:compaction && npm run test:guard",
    "test:gemini-handoff": "test/router/run-gemini-handoff.sh"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1"
  },
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/scoby/index.ts"
    ]
  }
}
