{
  "connections": {
    "gemini": { "provider": "google" },
    "groq":   { "provider": "groq" },
    "nim": {
      "baseUrl": "https://integrate.api.nvidia.com/v1",
      "apiKeyEnv": "NVIDIA_API_KEY",
      "models": [
        { "id": "deepseek-ai/deepseek-v4-flash-0731", "contextWindow": 128000, "maxTokens": 8192 },
        { "id": "nvidia/nemotron-3-super-120b-a12b", "contextWindow": 128000, "maxTokens": 8192 }
      ]
    }
  },
  "policy": { "repoContentLeavesMachine": true },
  "roles": {
    "builder":   ["nim/deepseek-ai/deepseek-v4-flash-0731", "nim/nvidia/nemotron-3-super-120b-a12b"],
    "planner":   ["gemini/gemini-3.5-flash:low", "nim/nvidia/nemotron-3-super-120b-a12b"],
    "judge":     ["gemini/gemini-3.5-flash:low", "groq/openai/gpt-oss-120b", "nim/nvidia/nemotron-3-super-120b-a12b"],
    "compactor": ["nim/nvidia/nemotron-3-super-120b-a12b"]
  },
  "defaultRole": "builder",
  "failover": { "cooldownSeconds": 300, "authCooldownSeconds": 1800 },
  "compaction": { "defaultBudget": 32000, "recentShare": 0.5 },
  "ferment": { "enabled": true, "waitIntervalSeconds": 600, "waitNotifyAfterSeconds": 1800 },
  "finish": { "gates": [] },
  "notify": { "url": "https://ntfy.sh", "topic": "your-private-topic", "tokenEnv": "NTFY_TOKEN" }
}
